#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        vim_lower_g: vim_lower_g {
            compatible = "zmk,behavior-tap-dance";
            label = "VIM_LOWER_G";
            #binding-cells = <0>;
            bindings = <&kp G>, <&kp LG(UP_ARROW)>;
        };

        vim_g: vim_g {
            compatible = "zmk,behavior-mod-morph";
            label = "VIM_G";
            bindings = <&vim_lower_g>, <&kp LG(DOWN)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        vim_r: vim_r {
            compatible = "zmk,behavior-mod-morph";
            label = "VIM_R";
            bindings = <&kp R>, <&kp LG(LS(Z))>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        vim_n: vim_n {
            compatible = "zmk,behavior-mod-morph";
            label = "VIM_N";
            bindings = <&kp LG(G)>, <&kp LG(LS(G))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        dw {
            bindings = <&kp RA(BACKSPACE)>;
            key-positions = <31 16>;
            timeout-ms = <100>;
            require-prior-idle-ms = <300>;
            layers = <4>;
        };

        db {
            bindings = <&kp LA(DELETE)>;
            key-positions = <31 51>;
            timeout-ms = <100>;
            require-prior-idle-ms = <300>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1       &kp N2          &kp N3          &kp N4            &kp N5   &none                                                         &mo 7      &kp N6   &kp N7             &kp N8           &kp N9           &kp N0                  &kp MINUS
&kp TAB    &kp Q        &kp W           &kp E           &kp R             &kp T    &tog 3                                                        &tog 4     &kp Y    &kp U              &kp I            &kp O            &kp P                   &kp BSLH
&kp ESC    &hm LCTRL A  &hm LEFT_ALT S  &hm LEFT_GUI D  &hm LEFT_SHIFT F  &lt 2 G  &tog 5         &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &lt 2 H  &hm RIGHT_SHIFT J  &hm RIGHT_GUI K  &hm RIGHT_ALT L  &hm RIGHT_CONTROL SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X           &kp C           &kp V             &kp B                              &kp HOME      &kp PG_UP                        &kp N    &kp M              &kp COMMA        &kp DOT          &kp FSLH                &tog 2
&mo 6      &kp GRAVE    &kp CAPS        &kp LEFT        &kp RIGHT                  &kp BACKSPACE  &sl 1      &kp END       &kp PG_DN  &kp ENTER  &kp SPACE           &kp UP             &kp DOWN         &kp LBKT         &kp RBKT                &mo 4
            >;
        };

        symbol_layer {
            bindings = <
&trans  &trans           &trans            &trans          &trans           &trans             &trans                                      &trans  &trans      &trans          &trans                &trans                 &trans      &trans
&trans  &trans           &kp LESS_THAN     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET   &trans                                      &trans  &kp DOLLAR  &kp PIPE        &kp TAB               &kp AMPERSAND          &trans      &trans
&trans  &kp KP_NUMBER_0  &kp GREATER_THAN  &kp ASTERISK    &kp MINUS        &kp RIGHT_BRACKET  &trans  &trans  &trans      &trans  &trans  &trans  &kp EQUAL   &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERIOD  &trans
&trans  &trans           &kp EXCLAMATION   &kp CARET       &kp TILDE        &kp KP_NUMBER_1                    &trans      &trans                  &kp HASH    &kp PLUS        &kp QUESTION          &kp SLASH              &trans      &trans
&trans  &trans           &trans            &trans          &trans                              &trans  &trans  &trans      &trans  &trans  &trans              &trans          &trans                &trans                 &trans      &trans
            >;
        };

        number_layer {
            bindings = <
&trans  &trans     &trans           &trans           &trans           &trans           &trans                                      &trans  &trans           &trans           &trans           &trans     &trans           &trans
&trans  &trans     &trans           &trans           &trans           &trans           &trans                                      &trans  &trans           &trans           &trans           &trans     &trans           &trans
&trans  &kp KP_N3  &kp KP_NUMBER_2  &kp KP_NUMBER_1  &kp KP_NUMBER_0  &kp KP_NUMBER_4  &trans  &trans  &trans      &trans  &trans  &trans  &kp KP_NUMBER_5  &kp KP_NUMBER_9  &kp KP_NUMBER_8  &kp KP_N7  &kp KP_NUMBER_6  &trans
&trans  &trans     &trans           &trans           &trans           &trans                           &trans      &trans                  &trans           &trans           &trans           &trans     &trans           &trans
&trans  &trans     &trans           &trans           &trans                            &trans  &trans  &trans      &trans  &trans  &trans                   &trans           &trans           &trans     &trans           &trans
            >;
        };

        vanilla {
            bindings = <
&kp EQUAL  &kp N1     &kp N2  &kp N3    &kp N4     &kp N5  &trans                                                            &trans     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W   &kp E     &kp R      &kp T   &trans                                                            &trans     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S   &kp D     &kp F      &kp G   &trans    &kp DEL    &kp LEFT_ALT      &kp LEFT_COMMAND  &trans   &trans     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C     &kp V      &kp B                        &trans            &trans                                &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp LSHFT
&trans     &kp GRAVE  &kp Y   &kp LEFT  &kp RIGHT          &kp BSPC  &kp LCTRL  &trans            &trans            &kp RET  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &trans
            >;
        };

        vim {
            bindings = <
&none   &none  &none          &none  &kp LG(RIGHT)  &none         &trans                                         &trans  &none      &none      &none   &none      &kp LG(LEFT)  &none
&trans  &none  &kp LA(RIGHT)  &none  &vim_r         &none         &trans                                         &trans  &kp LG(C)  &kp LG(Z)  &none   &none      &kp LG(V)     &none
&trans  &none  &none          &none  &none          &vim_g        &trans  &trans     &trans      &trans  &trans  &trans  &kp LEFT   &kp DOWN   &kp UP  &kp RIGHT  &none         &none
&trans  &none  &kp LG(X)      &none  &none          &kp LA(LEFT)                     &trans      &trans                  &vim_n     &none      &none   &none      &kp LG(F)     &none
&trans  &none  &none          &none  &none                        &trans  &kp LCTRL  &trans      &trans  &trans  &trans             &none      &none   &none      &none         &trans
            >;
        };

        league {
            bindings = <
&trans      &trans        &trans        &trans        &trans            &trans  &trans                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp NUMBER_1  &kp NUMBER_2  &kp N3        &kp N4            &kp T   &trans                                           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB     &kp Q         &kp W         &kp E         &kp R             &kp U   &trans     &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp GRAVE   &kp H         &kp P         &kp D         &kp F             &kp B                        &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp LC(NUMBER_6)          &kp SPACE  &kp LALT  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans                                      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
